NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/geeko
NEXT_PUBLIC_CONTACT_EMAIL=contato@geeko.com.br
NEXT_PUBLIC_ADMIN_PASS=geeko123
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dimona API V2 (SERVER-ONLY — nunca exponha no cliente, nunca commite valores)
# Ativa a cotação exata de frete em /api/freight/quote. Sem a chave, usa tabela fixa.
DIMONA_API_BASE_URL=https://admin.camisadimona.com.br
DIMONA_API_KEY=
# Path de criação de pedido (ajuste se sua conta usar outro, sem mexer em código)
DIMONA_ORDERS_PATH=/api/v2/orders

# Mercado Pago (SERVER-ONLY — aceita teste e produção, o token define o ambiente)
# Sandbox:  MP_ACCESS_TOKEN=TEST-... (token de TESTE) + conta de usuário de teste como comprador
# Produção: MP_ACCESS_TOKEN=APP_USR-... (token de PRODUÇÃO)
MP_ACCESS_TOKEN=
# Chave de validação do webhook (Painel MP > Sua integração > Webhooks > detalhes).
# Vale para teste e produção. Sem ela, a validação HMAC é pulada (só dev local).
MP_WEBHOOK_SECRET=
# Chave de serviço do Supabase (Dashboard > Settings > API > service_role). Só no servidor (webhook/checkout).
SUPABASE_SERVICE_ROLE_KEY=
# URL pública do site (para notification_url + back_urls do MP).
# Local:   NEXT_PUBLIC_SITE_URL=http://localhost:3000 (pagamento funciona, mas o
#          webhook NÃO chega no localhost — exponha com ngrok e use a URL pública aqui)
# Vercel:  NEXT_PUBLIC_SITE_URL=https://geeko.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tabela fixa de frete por região (fallback) — calibre com simulações no site Dimona
DIMONA_FREIGHT_SUDESTE=19.9
DIMONA_FREIGHT_SUL=24.9
DIMONA_FREIGHT_CENTRO_OESTE=24.9
DIMONA_FREIGHT_NORDESTE=34.9
DIMONA_FREIGHT_NORTE=39.9
